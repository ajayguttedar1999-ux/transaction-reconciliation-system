<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="transaction-service"/>

    <!-- Standard Human-Readable Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} [traceId=%X{traceId:-NONE}] - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Splunk Structured JSON Appender -->
    <appender name="SPLUNK_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"${appName}","environment":"production"}</customFields>
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>productId</includeMdcKeyName>
            <includeMdcKeyName>transactionId</includeMdcKeyName>
            <includeMdcKeyName>runId</includeMdcKeyName>
        </encoder>
    </appender>

    <!-- Default: Use CONSOLE with traceId support -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- Activate JSON logging when spring profile 'splunk' or 'k8s' is active -->
    <springProfile name="splunk,k8s,prod">
        <root level="INFO">
            <appender-ref ref="SPLUNK_JSON"/>
        </root>
    </springProfile>
</configuration>
